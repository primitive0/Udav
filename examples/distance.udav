fun isqrt(n):
    let low = 0, high = n, ans = 0

    while low <= high:
        let mid = (low + high) / 2
        let sq = mid * mid

        if sq == n:
            return mid
        elif sq < n:
            ans = mid
            low = mid + 1
        else:
            high = mid - 1

    return ans

fun main():
    let x1 = int(readln())
    let y1 = int(readln())
    let x2 = int(readln())
    let y2 = int(readln())

    let dx = x2 - x1
    let dy = y2 - y1

    let d2 = dx * dx + dy * dy
    let scaled = isqrt(d2 * 10000)

    let integer = scaled / 100
    let frac = scaled % 100

    if frac < 10:
        println(integer, ".0", frac)
    else:
        println(integer, ".", frac)
