# RUN: %udav %s | FileCheck %s

fun main():
    println(0 != 0)           # CHECK: false
    println(false != false)   # CHECK-NEXT: false
    println("" != "")         # CHECK-NEXT: false

    println(1 != 0)           # CHECK-NEXT: true
    println(false != true)    # CHECK-NEXT: true
    println("a" != "b")       # CHECK-NEXT: true
    println(null != 0)        # CHECK-NEXT: true
    println(null != false)    # CHECK-NEXT: true
    println("0" != 0)         # CHECK-NEXT: true
    println("false" != false) # CHECK-NEXT: true
