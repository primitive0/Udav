# RUN: %udav %s | FileCheck %s

fun main():
    println(1 < 2)        # CHECK: true
    println(2 < 1)        # CHECK-NEXT: false

    println(2 > 1)        # CHECK-NEXT: true
    println(1 > 2)        # CHECK-NEXT: false

    println(2 <= 2)       # CHECK-NEXT: true
    println(3 <= 2)       # CHECK-NEXT: false

    println(2 >= 2)       # CHECK-NEXT: true
    println(1 >= 2)       # CHECK-NEXT: false
