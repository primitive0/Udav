# RUN: %udav %s | FileCheck %s

fun main():
    println(null == null)   # CHECK: true
    println(42 == 42)       # CHECK-NEXT: true
    println("foo" == "foo") # CHECK-NEXT: true
    println(true == true)   # CHECK-NEXT: true

    println("Foo" == "foo") # CHECK-NEXT: false
    println(null == "bar")  # CHECK-NEXT: false
    println(123 == null)    # CHECK-NEXT: false
    println(123 == true)    # CHECK-NEXT: false
    println("text" == true) # CHECK-NEXT: false
    println("" == false)    # CHECK-NEXT: false
