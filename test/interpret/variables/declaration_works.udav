# RUN: %udav %s | FileCheck %s

# TODO: Use strict FileCheck mode

fun main():
    let a = 5 ** 0
    let b = 2
    println(a)                # CHECK: 1
    println(b)                # CHECK: 2

    let c = 2 + 3, d = 4 + 5
    println(c)                # CHECK: 5
    println(d)                # CHECK: 9

    let __Variable__ = "foo"
    println(__Variable__)     # CHECK: foo

    let BoolVar = true
    println(BoolVar)          # CHECK: true

    let nullvar = null
    println(nullvar)          # CHECK: null
