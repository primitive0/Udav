# RUN: %udav %s | FileCheck --match-full-lines --strict-whitespace %s

fun main():
    print("This")
    print("Is", "Print")
    print("Printing", "Text", "That")
    print("Is")
    print("Saying")
    print("That")
    print("Print", "Is")
    print()
    print()
    print()
    print()
    print()
    print()
    print()
    print()
    print("WorkingAsExpected")

    # CHECK:ThisIsPrintPrintingTextThatIsSayingThatPrintIsWorkingAsExpected

    println()

    print(123)
    print(4567890)
    print("|")
    print(0)
    print("|")
    print(0000)
    print("|")
    print(007)
    print("|")
    print(009) # This must be parsed as decimal
    print("|")
    print(4, 2, 0, 0, 6, 3, 3, 3)

    # CHECK:1234567890|0|0|7|9|42006333

    println()

    print(99999999999999999999999999999999999999999999999999999999999999)
    # CHECK:99999999999999999999999999999999999999999999999999999999999999

    println()

    print(true)
    print(" ")
    print(false)
    print("|")
    print(true, false, true)

    # CHECK:true false|truefalsetrue

    println()

    print("value=", 2325, ", ok=", true, ", fail=", false)
    # CHECK:value=2325, ok=true, fail=false
