# RUN: %udav %s | FileCheck --match-full-lines --strict-whitespace %s

fun main():
    println(int(""))       # CHECK:null
    println(int("-"))      # CHECK-NEXT:null
    println(int("foo"))    # CHECK-NEXT:null
    println(int("-foo"))   # CHECK-NEXT:null
    println(int("1a"))     # CHECK-NEXT:null
    println(int("-1a"))    # CHECK-NEXT:null
    println(int("f1"))     # CHECK-NEXT:null
    println(int("-f1"))    # CHECK-NEXT:null
    println(int("0x123"))  # CHECK-NEXT:null
    println(int("-0x123")) # CHECK-NEXT:null
    println(int("0b010"))  # CHECK-NEXT:null
    println(int("-0b010")) # CHECK-NEXT:null
