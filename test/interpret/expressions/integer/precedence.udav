# RUN: %udav %s | FileCheck --match-full-lines --strict-whitespace %s

fun main():
    println(-2 ** 3)          # CHECK:-8

    println(2 * 3 ** 2)       # CHECK:18
    println(17 % 3 ** 2)      # CHECK:8
    println(20 / 3 ** 2)      # CHECK:2

    println(-10 + 3)          # CHECK:-7
    println(-10 - 3)          # CHECK:-13
    # Testing against multiplicative operators is meaningless

    println(2 + 12 / 5)       # CHECK:4
    println(25 - 8 * 2)       # CHECK:9
    println(3 + 17 % 6)       # CHECK:8

    println(1 << 2 + 1)       # CHECK:8
    println(64 >> 1 + 2)      # CHECK:8

    println(10 & 3 << 1)      # CHECK:2
    println(12 & 5 << 2)      # CHECK:4

    println(12 ^ 10 & 7)      # CHECK:14
    println(5 ^ 6 & 3)        # CHECK:7

    println(1 | 2 ^ 3)        # CHECK:1
    println(2 | 6 ^ 3)        # CHECK:7
